# OpenAGI daemon
OPENAGI_URL=http://127.0.0.1:43210
OPENAGI_AUTH_TOKEN=

# ZeroClaw ACP (stdio primary)
ZEROCLAW_ACP_CMD=zeroclaw acp
ZEROCLAW_AGENT_ALIAS=
ZEROCLAW_ACP_CWD=
ZEROCLAW_ACP_TIMEOUT=120
ACP_AUTO_PERMISSION=allow-once
# Optional HTTP custom gateway only (not default ZeroClaw):
# ZEROCLAW_ACP_URL=http://127.0.0.1:18789/acp

# Buzz identity + room
BUZZ_RELAY_URL=ws://localhost:3000
BUZZ_PRIVATE_KEY=
BUZZ_CHANNEL_ID=
BUZZ_OWNER_PUBKEY=
BUZZ_CLI=buzz
# For buzz-acp room membership (separate process):
# BUZZ_ACP_AGENT_COMMAND=zeroclaw
# BUZZ_ACP_AGENT_ARGS=acp

# Bridge
POLL_INTERVAL=8
DRY_RUN=0
BRIDGE_STATE_DIR=.bridge-state
BRIDGE_ONCE=0
INCLUDE_OBSERVATIONS=0
LOG_LEVEL=INFO

# Compose sibling paths (optional overrides)
# OPENAGI_PATH=../openAGI
# ZEROCLAW_PATH=../zeroclaw
# BUZZ_PATH=../buzz

# Model keys (used by parent systems, not the bridge itself)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
