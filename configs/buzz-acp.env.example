# Run ZeroClaw as a first-class Buzz room member via buzz-acp.
# Build: (cd ../buzz && cargo build --release -p buzz-acp -p buzz-cli)
# Keys:  cargo run -p buzz-admin -- generate-key
#        BUZZ_RELAY_PRIVATE_KEY=... cargo run -p buzz-admin -- add-member --pubkey <hex>

BUZZ_PRIVATE_KEY=nsec1...
BUZZ_RELAY_URL=ws://localhost:3000
BUZZ_ACP_AGENT_COMMAND=zeroclaw
BUZZ_ACP_AGENT_ARGS=acp
# Optional: more workers, heartbeat for proactive room presence
# BUZZ_ACP_AGENTS=1
# BUZZ_ACP_HEARTBEAT_INTERVAL=0
# BUZZ_ACP_RESPOND_TO=owner-only
